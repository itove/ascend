#!/bin/bash
#
# vim:ft=bash

pdir=/mnt/d/s/modelscope
baseurl=https://www.modelscope.ai

_help(){
    echo Download weight into $pdir
    echo 'Usage: modelscope-download <user/model_name>'
}

modelname="$1"

if [ -z "$modelname" ]; then
    _help
    exit
fi

i=0
while :
do
    echo Start downloading model: $modelname
    echo cache dir: $pdir/cache
    echo weights dir: $pdir/$modelname
    let i++
    modelscope download \
        --model $modelname\
        --cache_dir $pdir/cache\
        --local_dir $pdir/$modelname\
        && break
done

echo Done. Tried $i times.

# Verify download
GIT_LFS_SKIP_SMUDGE=1 git clone $baseurl/$model_name $git_dir && \
    cd $hf_dir/$model_name; /mnt/d/s/ascend/bin/compare_checksum.sh $git_dir/$model_name
