#!/bin/bash
#
# vim:ft=bash

host=$1
U=${U:-$USER}
DIR=$(dirname $0)

if [ -z "$PASS" -o -z "$host" ]; then
    echo Usage: PASS=xxxxx $(basename $0) '<hostname>'
    exit
fi

if [[ "$host" == *@* ]]; then
    echo Ignoring specified user ${host%@*}, using root
    host=${host##*@}
fi

ssh root@$host "PASS=$PASS U=$U bash" < $DIR/adduser.sh

pushd ~/.ssh

ssh-keygen -t ed25519 -N '' -f $host
sed -i "/$host/d" known_hosts

sed -i "/$host/d" config

host_and_ip=$(grep $host /etc/hosts)

[ -z "$host_and_ip" ] && host_and_ip=$host

cat <<EOF >> config
Host $host_and_ip
    IdentityFile ~/.ssh/$host
EOF

ssh-copy-id -i $host $U@$host

popd
