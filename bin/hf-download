#!/bin/bash
#
# vim:ft=bash

export HF_ENDPOINT=https://hf-mirror.com
#export HF_HUB_ENABLE_HF_TRANSFER=1
hf_dir=/mnt/d/s/hf

_help(){
    echo Download weight into $hf_dir
    echo 'Usage: hf-download <user/model_name>'
}

modelname="$1"

if [ -z "$modelname" ]; then
    _help
    exit
fi

i=0
while :
do
    echo Start downloading model: $modelname
    echo weights dir: $hf_dir/$modelname
    let i++
    hf download $modelname\
        --local-dir $hf_dir/$modelname\
        && break
done

echo Done. Tried $i times.
