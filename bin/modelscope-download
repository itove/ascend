#!/bin/bash
#
# vim:ft=bash

weight_dir=/mnt/d/s/modelscope
baseurl=https://www.modelscope.cn
git_dir=/mnt/d/s/git/modelscope

_help(){
    echo Download weight into $weight_dir
    echo 'Usage: modelscope-download <user/model_name>'
}

model_name="$1"

if [ -z "$model_name" ]; then
    _help
    exit
fi

i=0
while :
do
    echo Start downloading model: $model_name
    echo cache dir: $weight_dir/cache
    echo weights dir: $weight_dir/$model_name
    let i++
    modelscope download \
        --model $model_name\
        --cache_dir $weight_dir/cache\
        --local_dir $weight_dir/$model_name\
        && break
done

echo Done. Tried $i times.

# Verify download
rm -rf $git_dir/$model_name
GIT_LFS_SKIP_SMUDGE=1 git clone $baseurl/$model_name $git_dir/$model_name && \
    { cd $weight_dir/$model_name; /mnt/d/s/ascend/bin/compare_checksum.sh $git_dir/$model_name; }
